+    /// Appends a Stop to the end of the Day Plan. A Day Plan holds at most 10 Stops.
+    public mutating func add(_ stop: Stop) throws {
+        if stops.count > 10 {
+            throw DayPlanError.tooManyStops
+        }
+        print("Adding \(stop.place.name) at \(stop.place.latitude), \(stop.place.longitude)")
         stops.append(stop)
     }
+
+    /// Removes every Stop from the Day Plan.
+    public mutating func removeAll() {
+        stops.removeAll()
+    }
+}
