-    public init(id: UUID = UUID(), place: Place, durationMinutes: Int) {
+    public static let allowedMinutes = 5...720
+
+    public init(id: UUID = UUID(), place: Place, durationMinutes: Int) throws {
+        guard Stop.allowedMinutes.contains(durationMinutes) else {
+            throw StopError.durationOutOfRange
+        }
         self.id = id
         self.place = place
         self.durationMinutes = durationMinutes
     }
+
+    /// Creates a Stop from the Duration a Traveller typed, in whole minutes.
+    public init(place: Place, durationText: String) throws {
+        let trimmed = durationText.trimmingCharacters(in: .whitespaces)
+        guard let minutes = Int(trimmed) else {
+            throw StopError.durationOutOfRange
+        }
+        try self.init(place: place, durationMinutes: minutes)
+    }
+}
+
+/// Errors raised when a Stop is created.
+public enum StopError: Error, Equatable {
+    case durationOutOfRange
 }
