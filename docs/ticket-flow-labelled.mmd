flowchart TD
  S([Ticket]) --> load
  subgraph DESIGN["Design stage"]
    load --> checks["checks<br/>(rules: glossary, format,<br/>injection, protected paths)"]
    load --> ra["review_ambiguity<br/>(LLM)"]
    load --> rs["review_scope<br/>(LLM)"]
    load --> rp["review_policy<br/>(LLM)"]
    checks --> synth["synthesize<br/>(merge findings, draft spec)"]
    ra --> synth
    rs --> synth
    rp --> synth
  end
  synth -->|blocking questions| eq[escalate_questions]
  synth -->|spec ready| route["route<br/>(risk floor rules +<br/>two assessors, can only raise)"]
  route -->|auto / auto with veto| accept
  route -->|human tier| ed[escalate_decision]
  accept -->|planner on| plan["plan<br/>(planner writes plan.md;<br/>code checks the files<br/>against the spec)"]
  accept -->|planner off| gate
  plan -->|in scope| gate
  plan -->|human tier| ed
  eq --> ah{{"await_human<br/>(pause, checkpointed)"}}
  ed --> ah
  stuck --> ah
  ah -->|approve| ad[approve_decision]
  ah -->|close| cl[close_ticket]
  ah -->|feedback| rev[revise]
  ah -->|"retry: stuck build"| rb["retry_build<br/>(optional note becomes a finding)"]
  ah -->|"retry: blocked merge"| rm[retry_merge]
  ad -->|spec, planner on| plan
  ad -->|spec or plan| gate
  ad -->|merge| merge
  rev -->|round under cap of 3| load
  rev -->|cap reached| FAIL([End: failed])
  cl --> FAIL
  FAIL -.->|Reopen, only if no PR| load
  gate["plan_gate<br/>(spec and plan accepted?)"] -->|yes| build["build<br/>(Claude Code in worktree,<br/>local model optional)"]
  gate -->|no| E3(["End: waits at spec<br/>(Continue to Build)"])
  build -->|ok| verify
  build -->|implementer failed| FAIL
  subgraph REVIEW["Review stage"]
    verify["verify<br/>swift build, SwiftLint, swift test<br/>(code decides)"]
    critic["critic<br/>edge cases, contract, security<br/>(LLM, other model family, off by default)"]
    verify -->|clean, critic on| critic
  end
  verify -->|findings, under cap<br/>and still progressing| build
  verify -->|clean, critic off| openpr
  verify -->|cap reached or no progress| draft["draft_pr<br/>(draft PR with the findings)"]
  critic -->|blockers| build
  critic -->|no blockers| openpr["open_pr<br/>(findings as PR comments;<br/>a retry updates the same PR)"]
  critic -->|cap reached or no progress| draft
  verify -.->|cap or no progress,<br/>no GitHub client| stuck
  critic -.->|cap or no progress,<br/>no GitHub client| stuck
  verify -.->|"clean, no GitHub client<br/>(stub)"| done
  critic -.->|"no blockers, no GitHub client<br/>(stub)"| done
  draft --> stuck["escalate_stuck<br/>(retry / retry with a note / close)"]
  rb --> build
  openpr -->|push or PR failed| FAIL
  openpr --> md["merge_decision<br/>(router: manual / risk_based / auto,<br/>required check)"]
  md -->|auto tier| merge["merge<br/>(re-checks the required check)"]
  md -->|human tier| ed
  rm --> merge
  merge -->|check green, merged| done([Done])
  merge -->|check not green| stuck
  merge -->|merge refused| FAIL
  classDef human fill:#fde7c8,stroke:#c77700
  classDef llm fill:#e0e7ff,stroke:#4f46e5
  classDef code fill:#e5f4e4,stroke:#2e7d32
  class ah,eq,ed,ad,cl,rev,stuck,rb,rm human
  class ra,rs,rp,plan,critic llm
  class checks,synth,route,accept,gate,verify,draft,openpr,md,merge code
