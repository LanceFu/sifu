	escalate_questions --> await_human;
	escalate_stuck --> await_human;
	load --> checks;
	load --> review_ambiguity;
	load --> review_policy;
	load --> review_scope;
	merge -.-> __end__;
	merge -.-> escalate_stuck;
	merge_decision -.-> escalate_decision;
	merge_decision -.-> merge;
	open_pr -.-> __end__;
	open_pr -.-> merge_decision;
	plan -.-> escalate_decision;
	plan -.-> plan_gate;
	plan_gate -.-> __end__;
	plan_gate -.-> build;
	retry_build --> build;
	retry_merge --> merge;
	review_ambiguity --> synthesize;
	review_policy --> synthesize;
	review_scope --> synthesize;
	revise -.-> __end__;
	revise -.-> load;
	route -.-> accept;
	route -.-> escalate_decision;
	synthesize -.-> escalate_questions;
