	checks --> synthesize;
	escalate_decision --> await_human;
	escalate_questions --> await_human;
	load --> checks;
	load --> review_ambiguity;
	load --> review_policy;
	load --> review_scope;
	plan_gate -.-> __end__;
	plan_gate -.-> build;
	review_ambiguity --> synthesize;
	review_policy --> synthesize;
	review_scope --> synthesize;
	revise -.-> __end__;
	revise -.-> load;
	route -.-> accept;
	route -.-> escalate_decision;
	synthesize -.-> escalate_questions;
	synthesize -.-> route;
	test --> done;
	close_ticket --> __end__;
	done --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
